import { describe, it, expect } from 'vitest';

describe('SPM Architecture Integration', () => {
  const PROMETHEUS_URL = 'http://localhost:9090/api/v1/query';
  const JAEGER_METRICS_URL = 'http://localhost:8889/metrics';

  it('should expose metrics on Jaeger v2 SpanMetrics endpoint', async () => {
    const res = await fetch(JAEGER_METRICS_URL);
    expect(res.status).toBe(200);
    const text = await res.text();
    // Check for SpanMetrics specific OTel attributes
    expect(text).toContain('calls_total');
    expect(text).toContain('duration_milliseconds');
  });

  it('should be indexed by Prometheus', async () => {
    // We query Prometheus for the 'calls_total' metric derived from our spans
    // Note: This might take a few seconds to populate after a run
    const query = encodeURIComponent('calls_total{service_name="hn-digest-worker"}');
    const res = await fetch(`${PROMETHEUS_URL}?query=${query}`);
    expect(res.status).toBe(200);
    const data = await res.json();

    expect(data.status).toBe('success');
    // We don't strictly require data points yet, just that the metric is known
    expect(data.data.resultType).toBe('vector');
  });

  it('should track error rates via SpanMetrics', async () => {
    const query = encodeURIComponent('calls_total{status_code="STATUS_CODE_ERROR"}');
    const res = await fetch(`${PROMETHEUS_URL}?query=${query}`);
    const data = await res.json();
    expect(data.status).toBe('success');
  });
});
